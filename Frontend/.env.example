# Base URL of the backend API. Override per environment (dev / staging / prod).
VITE_API_URL=http://localhost:5000

# Demo fallback: when the backend is unreachable, serve dummy data so the
# whole frontend stays usable (e.g. secured facility with no DB access).
# Set to false to disable and surface real network errors instead.
VITE_DEMO_FALLBACK=true
