# ── Backend environment ────────────────────────────────────────────────────
# Copy to .env and fill in. Values marked (required) must be set or the server
# refuses to boot (see config/index.js).

# (required) MongoDB connection string
ATLAS_URI=mongodb+srv://user:pass@cluster.mongodb.net/timetable

# (required) Secret used to sign JWTs
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development

# Python OR-Tools solver service
SOLVER_URL=http://127.0.0.1:8000
SOLVER_TIMEOUT_MS=60000

# CORS — comma-separated allowed origins. Use '*' for local dev only.
# e.g. CORS_ORIGINS=https://app.yourcollege.edu,https://admin.yourcollege.edu
CORS_ORIGINS=*

# Auto-open Swagger UI (/api-docs) in the browser on dev startup. Set to false to disable.
OPEN_DOCS=true
